{
  "name": "span_near_ordered",
  "index": "cc-wet",
  "description": "Two span terms within 5 positions of each other, in order. This is the span equivalent of a sloppy phrase.",
  "bindings": {
    "Word1": {
      "source": "file",
      "path": "./assets/query/terms/lowercase-terms.txt"
    },
    "Word2": {
      "source": "file",
      "path": "./assets/query/terms/lowercase-terms.txt"
    }
  },
  "template": {
    "_source": false,
    "query": {
      "span_near": {
        "clauses": [
          {
            "span_term": {
              "content": "{{.Word1}}"
            }
          },
          {
            "span_term": {
              "content": "{{.Word2}}"
            }
          }
        ],
        "slop": 5,
        "in_order": true
      }
    }
  }
}
