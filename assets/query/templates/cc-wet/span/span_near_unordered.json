{
  "name": "span_near_unordered",
  "index": "cc-wet",
  "description": "The same two terms within 5 positions in any order. Unordered matching visits more position combinations than the ordered variant.",
  "bindings": {
    "Word1": {
      "source": "file",
      "path": "./assets/query/terms/lowercase-terms.txt"
    },
    "Word2": {
      "source": "file",
      "path": "./assets/query/terms/lowercase-terms.txt"
    }
  },
  "template": {
    "_source": false,
    "query": {
      "span_near": {
        "clauses": [
          {
            "span_term": {
              "content": "{{.Word1}}"
            }
          },
          {
            "span_term": {
              "content": "{{.Word2}}"
            }
          }
        ],
        "slop": 5,
        "in_order": false
      }
    }
  }
}
