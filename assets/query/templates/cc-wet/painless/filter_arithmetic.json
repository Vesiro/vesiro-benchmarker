{
  "name": "filter_arithmetic",
  "index": "cc-wet",
  "description": "Primitive integer and floating-point arithmetic with no doc access at all. Isolates raw expression evaluation from field access.",
  "bindings": {
    "Day": {
      "source": "file",
      "path": "./assets/query/terms/date-values.txt"
    }
  },
  "template": {
    "_source": false,
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "date": {
                "gte": "{{.Day}}||/d",
                "lt": "{{.Day}}||/d+1d"
              }
            }
          },
          {
            "script": {
              "script": {
                "source": "int a = 17; long b = a * 31L; double c = b / 3.5 + 4.25; return c >= 0;"
              }
            }
          }
        ]
      }
    }
  }
}
