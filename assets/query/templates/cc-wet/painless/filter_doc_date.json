{
  "name": "filter_doc_date",
  "index": "cc-wet",
  "description": "Date doc values materialised as a ZonedDateTime and queried. The object construction is the cost, not the read.",
  "bindings": {
    "Day": {
      "source": "file",
      "path": "./assets/query/terms/date-values.txt"
    }
  },
  "template": {
    "_source": false,
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "date": {
                "gte": "{{.Day}}||/d",
                "lt": "{{.Day}}||/d+1d"
              }
            }
          },
          {
            "script": {
              "script": {
                "source": "return doc['date'].value.getYear() > 1970;"
              }
            }
          }
        ]
      }
    }
  }
}
