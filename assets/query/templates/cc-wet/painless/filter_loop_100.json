{
  "name": "filter_loop_100",
  "index": "cc-wet",
  "description": "A hundred loop iterations per document. Pairs with filter_arithmetic to show what the loop itself costs once the body is trivial.",
  "bindings": {
    "Day": {
      "source": "file",
      "path": "./assets/query/terms/date-values.txt"
    }
  },
  "template": {
    "_source": false,
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "date": {
                "gte": "{{.Day}}||/d",
                "lt": "{{.Day}}||/d+1d"
              }
            }
          },
          {
            "script": {
              "script": {
                "source": "long x = 0; for (int i = 0; i < 100; i++) { x += i; } return x >= 0;"
              }
            }
          }
        ]
      }
    }
  }
}
