{
  "name": "filter_baseline",
  "index": "cc-wet",
  "description": "Returns true and does nothing else. This is the invocation floor: every other filter template costs this plus its feature, so subtract it before quoting a number for anything here.",
  "bindings": {
    "Day": {
      "source": "file",
      "path": "./assets/query/terms/date-values.txt"
    }
  },
  "template": {
    "_source": false,
    "size": 0,
    "track_total_hits": true,
    "query": {
      "bool": {
        "filter": [
          {
            "range": {
              "date": {
                "gte": "{{.Day}}||/d",
                "lt": "{{.Day}}||/d+1d"
              }
            }
          },
          {
            "script": {
              "script": {
                "source": "return true;"
              }
            }
          }
        ]
      }
    }
  }
}
